# Copy this file to .env and fill in real values. Never commit .env.

# --- App ---
ENVIRONMENT=local

# --- Database ---
POSTGRES_USER=orvella
POSTGRES_PASSWORD=
POSTGRES_DB=orvella
# Host port Postgres is exposed on for local DB-client access. Change this if
# another local project's Postgres container already holds 5432.
POSTGRES_PORT=5432
# Host must be the Docker Compose service name ("postgres"), not localhost.
DATABASE_URL=postgresql+asyncpg://<user>:<password>@postgres:5432/orvella

# --- JWT ---
# Phase 1 placeholder values only. Token lifetime/refresh/revocation strategy
# is formalized in Phase 3 (Authentication and Access) - do not treat these as final.
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- CORS ---
CORS_ORIGINS=http://localhost:6200

# --- Platform admin bootstrap ---
# Consumed only by scripts/seed_platform_admin.py. Not read by the app at runtime.
# Use a normal registrable domain (not .local/.test/etc.) - email-validator
# rejects reserved/special-use TLDs even for local dev.
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_PASSWORD=

# --- Backend server ---
BACKEND_PORT=8000

# --- Tenancy ---
# Base domain tenant subdomains are resolved against (e.g. <slug>.orvella.com)
# and enforced on every tenant-scoped route (see app/api/deps.py). For local
# dev, use localtest.me - a public DNS wildcard that always resolves to
# 127.0.0.1, so e.g. kem-school.localtest.me works in a browser with zero
# DNS setup. Switch to the real base domain for staging/production.
BASE_DOMAIN=orvella.com
